# Copy to `.env` (git-ignored) and fill in.
#
# ---------------------------------------------------------------------------
# Dev environment (read by zotero-plugin-scaffold: `npm start`, `npm test`)
# ---------------------------------------------------------------------------

# Zotero binary. For the Flatpak install use the wrapper in scripts/.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /absolute/path/to/zotero-plugin/scripts/zotero-flatpak.sh

# Profile and data directory of the dev instance. Keep both inside this repo
# (.dev/ is git-ignored) so the dev Zotero never opens your real ~/Zotero.
ZOTERO_PLUGIN_PROFILE_PATH = /absolute/path/to/zotero-plugin/.dev/profile
ZOTERO_PLUGIN_DATA_DIR = /absolute/path/to/zotero-plugin/.dev/data

# Only kill dev/test instances (profiles under this repo). The scaffold's
# default on Linux is "pkill -9 zotero", which also kills your normal Zotero.
ZOTERO_PLUGIN_KILL_COMMAND = pkill -9 -f -- '-profile /absolute/path/to/zotero-plugin/[.]'

# ---------------------------------------------------------------------------
# Plugin settings for the dev instance (applied by `npm run dev:settings`).
# The plugin itself reads its settings from Zotero (Settings → Concept Lens);
# these only pre-fill the dev Zotero. Empty values are left unchanged.
# API keys go to Zotero's login manager, the rest to prefs.
# ---------------------------------------------------------------------------

# Decision model: filters concept candidates (one yes/no question each) and
# picks the best defining sentence.
# Format: "systemone" (OpenRouter /systemone route, e.g. Jev) or "chat"
# (an OpenAI-compatible chat model asked for yes/no probabilities).
CONCEPTLENS_DECISION_FORMAT = systemone
CONCEPTLENS_DECISION_ENDPOINT = https://openrouter.ai/api/v1/systemone
CONCEPTLENS_DECISION_MODEL = typesafe/jev-1.14
CONCEPTLENS_DECISION_API_KEY =
# Link threshold in percent (0-100)
CONCEPTLENS_DECISION_THRESHOLD = 80

# LLM fallback: writes a short definition when no paper in the library
# defines the concept.
# Format: "openai" (chat/completions) or "anthropic" (Anthropic Messages API).
# Anthropic: endpoint https://api.anthropic.com, model e.g. claude-haiku-5-5
# (also works with Anthropic-compatible endpoints such as
# https://api.deepseek.com/anthropic).
# Endpoint examples: https://api.deepseek.com (model deepseek-flash or
# deepseek-v4-pro), https://openrouter.ai/api/v1, http://localhost:8080/v1
# dev:settings picks the provider in the settings dropdown from these values:
# DeepSeek or Anthropic when endpoint, format and model match one of their
# preset models (the key then goes to that provider), else "Custom endpoint".
CONCEPTLENS_LLM_FORMAT = openai
CONCEPTLENS_LLM_ENDPOINT =
CONCEPTLENS_LLM_MODEL =
CONCEPTLENS_LLM_API_KEY =
